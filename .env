# Model Training Configuration
# Models
MODEL_TYPES=LogisticRegression,RandomForest

# General
RANDOM_SEED=42
TEST_SIZE=0.2

# Logistic Regression
LR_MAX_ITER=1000

# Random Forest
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=10

# Data
DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Output
MODEL_OUTPUT_PATH=./models
LOG_DIR=./logs
OUTPUT_DIR=./outputs

# MLflow
MQTT_BROKER=localhost
MQTT_PORT=1883

MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=G44_logibridge_miniproject

# Environment
ENVIRONMENT=development
DEBUG=True